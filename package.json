{
  "name": "webgal-lovelive-model-converter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:js && npm run test:python",
    "test:js": "node tools/run-browser-tests.mjs tests/*.test.js",
    "test:install-browser": "node tools/install-test-browser.mjs",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:integration": "node tools/run-browser-tests.mjs tests/integration/preview-formal-stress.test.js",
    "convert": "python convert.py",
    "convert:clean": "python convert.py --clean",
    "merge:index": "python convert.py --merge-only",
    "preview:models": "node tools/generate-model-previews.mjs",
    "export:garupa-live2d": "node tools/export-garupa-live2d.mjs",
    "convert:hasunosora": "python convert.py --game hasunosora",
    "convert:hasunosora:clean": "python convert.py --game hasunosora --clean",
    "convert:bangdream": "python convert.py --game bangdream",
    "convert:bangdream:clean": "python convert.py --game bangdream --clean",
    "convert:llas": "python convert.py --game llas",
    "convert:llas:clean": "python convert.py --game llas --clean",
    "bake:hasunosora": "python -m converter.bake_hasunosora",
    "bake:hasunosora:models": "python -m converter.bake_hasunosora --models-only",
    "bake:hasunosora:motions": "python -m converter.bake_hasunosora --motions-only",
    "bake:bangdream": "npm run bake:bangdream:models && npm run bake:bangdream:motions",
    "bake:bangdream:models": "python -m converter.bake_bangdream --models-only",
    "bake:bangdream:motions": "python -m converter.bake_bangdream_motion",
    "bake:llas": "python -m converter.bake_llas",
    "bake:llas:models": "python -m converter.bake_llas --models-only",
    "bake:llas:motions": "python -m converter.bake_llas --motions-only",
    "classify:llas": "python -m converter.classify_llas",
    "verify:bangdream-motions": "python -m converter.bake_bangdream_motion --verify-only",
    "convert:full:hasunosora": "npm run bake:hasunosora && npm run convert:hasunosora:clean",
    "convert:full:bangdream": "npm run bake:bangdream && npm run convert:bangdream:clean",
    "convert:full:llas": "npm run bake:llas && npm run convert:llas:clean",
    "convert:full": "npm run bake:hasunosora && npm run bake:bangdream && npm run bake:llas && npm run convert:clean",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "webgal-lovelive-gltf-renderer": "git+https://github.com/NijiharaTsubasa/webgal-lovelive-gltf-renderer.git",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.62.0",
    "vite": "^6.1.0"
  }
}
